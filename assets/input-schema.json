{
  "synthetic_origin": "OpenAI, GPT-6.1, via Codex. A human did not make this change directly, a system did.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ireland-samantha:keycloak-production-security:input-v1",
  "title": "Keycloak production security assessment input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "current", "candidate", "environment", "policy"],
  "properties": {
    "schema": {"const": "iam.keycloak.production-security/input-v1"},
    "current": {"$ref": "#/$defs/release"},
    "candidate": {"$ref": "#/$defs/release"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "topology", "customizations", "journeys"],
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "version", "clone_available", "restore_tested"],
          "properties": {
            "engine": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "clone_available": {"type": "boolean"},
            "restore_tested": {"type": "boolean"}
          }
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "cache_mode", "mixed_version_supported"],
          "properties": {
            "nodes": {"type": "integer", "minimum": 1},
            "cache_mode": {"type": "string", "minLength": 1},
            "mixed_version_supported": {"type": "boolean"}
          }
        },
        "customizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "source_revision", "compatibility_test"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "kind": {"enum": ["provider", "theme", "extension", "script", "other"]},
              "source_revision": {
                "type": "string",
                "pattern": "^(?:(?:commit|git):[0-9a-f]{40}|sha256:[0-9a-f]{64})$"
              },
              "compatibility_test": {"type": "string", "minLength": 1}
            }
          }
        },
        "journeys": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_critical", "block_fixable_high", "automatic_patch_only",
                   "minimum_stability_seconds", "rpo_seconds", "rto_seconds"],
      "properties": {
        "block_critical": {"type": "boolean"},
        "block_fixable_high": {"type": "boolean"},
        "automatic_patch_only": {"const": true},
        "minimum_stability_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "rpo_seconds": {"type": "integer", "minimum": 0},
        "rto_seconds": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_commit", "upstream_image", "upstream_platform_digest",
                   "image", "platform_digest"],
      "properties": {
        "version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "upstream_image": {"type": "string", "pattern": "^[a-z0-9.-]+(?::[1-9][0-9]{0,4})?(?:/[a-z0-9._-]+)+@sha256:[0-9a-f]{64}$"},
        "upstream_platform_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "image": {"type": "string", "pattern": "^[a-z0-9.-]+(?::[1-9][0-9]{0,4})?(?:/[a-z0-9._-]+)+@sha256:[0-9a-f]{64}$"},
        "platform_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
